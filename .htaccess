# Reglas para Hostinger (Apache/LiteSpeed). GitHub Pages ignora este archivo.
RewriteEngine On

# Forzar HTTPS y dominio sin www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://erconnectia.com%{REQUEST_URI} [L,R=301]

ErrorDocument 404 /404.html

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml
</IfModule>

# Caché del navegador
<IfModule mod_expires.c>
  ExpiresActive On
  # Los recursos llevan huella (?v=…) en el HTML: pueden cachearse un año sin riesgo de quedar viejos
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 week"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 week"
  # El HTML nunca se guarda: así siempre apunta a las versiones más recientes de CSS y JS
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
